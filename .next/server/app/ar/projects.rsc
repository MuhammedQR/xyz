8:["$","$L9",null,{"formats":"$undefined","locale":"ar","messages":{"nav":{"home":"الرئيسية","about":"من نحن","services":"الخدمات","projects":"المشاريع","contact":"تواصل","quote":"اطلب عرض سعر","lang":"English"},"hero":{"title":"شريكك الموثوق في <highlight>منشآت النفط والغاز</highlight>","subtitle":"إنشاء وتشغيل وصيانة المنشآت النفطية وفق أعلى معايير السلامة والجودة، مع خبرة تمتد عبر مشاريع في الشرق الأوسط.","contact":"تواصل معنا","projects":"شاهد مشاريعنا","servicesTitle":"خدمات أساسية","services":["هندسة وتصميم منشآت النفط والغاز","إدارة المشاريع والتشغيل والصيانة","السلامة والامتثال والمعايرة","اللوجستيات وسلاسل الإمداد"]},"cta":{"title":"جاهزون لبدء مشروعكم القادم؟","desc":"تواصل معنا لجدولة اجتماع تقني والحصول على عرض فني ومالي مبدئي خلال أيام.","btn":"احصل على عرض سعر"},"faqs":{"title":"الأسئلة الشائعة","subtitle":"إجابات مختصرة تساعدك على اتخاذ القرار.","list":[{"q":"ما نطاق خدماتكم الجغرافي؟","a":"نخدم دول الخليج والشرق الأوسط مع شركاء محليين معتمدين."},{"q":"هل توفرون عقود O&M طويلة الأجل؟","a":"نعم، نوفر نماذج مرنة تشمل SLAs ومؤشرات أداء."},{"q":"ما شهادات السلامة لديكم؟","a":"نلتزم بـ ISO 45001 ولوائح HSE المحلية والمعايير الدولية."}]},"footer":{"company":"شركة XYZ للمنشآت النفطية","rights":"جميع الحقوق محفوظة.","privacy":"سياسة الخصوصية","sitemap":"خريطة الموقع"},"hse":{"title":"السلامة والاعتمادات","subtitle":"التزام كامل بـ HSE والمعايير الدولية في كل مشروع.","items":[{"h":"ISO 9001","p":"نظم إدارة الجودة."},{"h":"ISO 14001","p":"نظم الإدارة البيئية."},{"h":"ISO 45001","p":"السلامة والصحة المهنية."},{"h":"API & ASME","p":"معايير المعدات والضغط واللحام."}]},"industries":{"title":"القطاعات التي نخدمها","subtitle":"خبرة عبر سلسلة قيمة النفط والغاز وما يرتبط بها.","items":[{"h":"Upstream","p":"منصات وآبار واستصلاح."},{"h":"Midstream","p":"خطوط الأنابيب ومحطات الضخ."},{"h":"Downstream","p":"التكرير، التخزين، التوزيع."},{"h":"Petrochemicals","p":"وحدات معالجة ومواد وسيطة."},{"h":"Marine/Offshore","p":"سواحل ومنشآت بحرية."},{"h":"Power & Utilities","p":"التوليد، الماء المبرد، البخار."}]},"process":{"title":"منهجية العمل","subtitle":"مسار واضح من الفكرة إلى التشغيل لضمان جودة وسلامة أعلى.","steps":[{"n":"01","t":"تحليل المتطلبات","d":"فهم نطاق العمل والأهداف والحوكمة."},{"n":"02","t":"الحل الهندسي","d":"تصميم مفهومي وتقدير التكلفة والجدولة."},{"n":"03","t":"التنفيذ","d":"توريد، إنشاء، اختبارات ما قبل التشغيل."},{"n":"04","t":"التسليم والتدريب","d":"إجراءات القبول والتوثيق ونقل المعرفة."},{"n":"05","t":"ما بعد التسليم","d":"O&M وخطط التحسين المستمر."}]},"services":{"title":"نبذة عن خدماتنا","subtitle":"حلول متكاملة تغطي دورة حياة المنشآت النفطية من التصميم إلى التشغيل.","items":[{"title":"EPC متكاملة","desc":"هندسة وشراء وإنشاء لمشاريع النفط والغاز وفق منهجية تسليم مفتاح."},{"title":"O&M التشغيل والصيانة","desc":"تشغيل موثوق وصيانة وقائية وتصحيحية لزيادة جاهزية الأصول."},{"title":"HSE وسلامة العمليات","desc":"أنظمة إدارة السلامة، تقييم المخاطر، وتدريب الفرق."},{"title":"أنابيب وخزانات","desc":"تصميم ومدّ خطوط الأنابيب وبناء خزانات التخزين والمعايرة."},{"title":"Instrumentation & SCADA","desc":"تركيب وبرمجة أنظمة القياس والتحكم والمراقبة."},{"title":"Supply Chain","desc":"توريد معدات معتمدة، إدارة مخزون، ولوجستيات المشاريع."}]},"stats":{"years":"سنة خبرة","projects":"مشروع منجز","satisfaction":"رضا العملاء","incidents":"حوادث جسيمة"},"testimonials":{"title":"قالوا عنّا","subtitle":"شهادات مختصرة من شركائنا وعملائنا.","items":[{"n":"شركة طاقة خليجية","q":"التزامهم بالسلامة وجودة التنفيذ كان فارقًا في مشروعنا."},{"n":"مجمع بتروكيميائي","q":"تسليم ضمن الجدول واحترافية عالية في إدارة المخاطر."}]},"why":{"title":"لماذا نحن","items":[{"h":"خبرة قطاعية","p":"فريق عمل بخبرة عميقة في تصميم وإدارة منشآت النفط والغاز."},{"h":"سلامة أولًا","p":"التزام صارم بمعايير HSE والامتثال التنظيمي في كل مرحلة."},{"h":"تسليم موثوق","p":"إدارة مشاريع دقيقة لضمان التسليم ضمن الوقت والميزانية."}]},"about":{"title":"من نحن","intro":"تأسست شركة XYZ لتقديم حلول متكاملة في مجال منشآت النفط والغاز، مع تركيز على الجودة، السلامة، والاستدامة. يجمع فريقنا بين الخبرة الهندسية والإدارية لتسليم مشاريع ناجحة في المنطقة.","imageAlt":"فريق شركة XYZ أثناء الاختبارات الميدانية","items":[{"h":"رؤيتنا","p":"أن نكون الشريك الصناعي الأكثر ثقة في قطاع النفط والغاز بالمنطقة."},{"h":"رسالتنا","p":"تقديم حلول موثوقة وفعالة تُحقق قيمة ملموسة لعملائنا."},{"h":"قيمنا","p":"السلامة – الاحترافية – الشفافية – الابتكار."}],"timelineTitle":"محطات وتطور الشركة","timelineIntro":"ملخص لأهم إنجازاتنا وامتداد خبراتنا خلال الأعوام الماضية.","timeline":[{"year":"2015","title":"الانطلاقة","text":"تأسيس الشركة وبناء الفريق الهندسي الأساسي."},{"year":"2018","title":"أول عقد EPC","text":"تنفيذ مشروع خطوط أنابيب مع تسليم ضمن الجدول."},{"year":"2021","title":"التوسع الإقليمي","text":"افتتاح مكتب تشغيلي جديد وتوسيع خدمات O&M."},{"year":"2024","title":"اعتمادات HSE","text":"تعزيز منظومة ISO وتطبيق مبادرات سلامة متقدمة."}]}},"now":"$undefined","timeZone":"Asia/Dubai","children":[["$","$La",null,{}],["$","main",null,{"children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","$3","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}]}],["$","$Lb",null,{}]]}]
